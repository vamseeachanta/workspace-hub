+
+def test_uv_resolver_is_source_safe_when_uv_missing(tmp_path: Path) -> None:
+    resolver = REPO_ROOT / "scripts" / "lib" / "uv-resolver.sh"
+    env = {"PATH": "/usr/bin:/bin"}
