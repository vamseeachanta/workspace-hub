     6	def require_queue_state():
     7	    try:
     8	        return importlib.import_module("scripts.email.queue_state")
     9	    except ModuleNotFoundError as exc:
    10	        pytest.fail(f"pending #2026 storage module: {exc}")
    11	
    12	
    13	@pytest.mark.xfail(reason="pending #2026 storage impl")
    14	def test_transition_inbound_to_extracted_writes_log(tmp_path):
    15	    queue_state = require_queue_state()
    16	    log = tmp_path / "queue-state.jsonl"
    17	
    18	    queue_state.transition(
    19	        log,
    20	        account_id="user@example.com",
    21	        thread_id="thread-1",
    22	        from_state="inbound",
    23	        to_state="extracted",
    24	        ts_utc="2026-04-20T00:00:00Z",
    25	    )
    26	
    27	    assert queue_state.lookup(log, "user@example.com", "thread-1")["state"] == "extracted"
    28	
    29	
    30	@pytest.mark.xfail(reason="pending #2026 storage impl")
