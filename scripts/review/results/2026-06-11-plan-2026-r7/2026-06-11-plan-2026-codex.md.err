    32	    queue_state = require_queue_state()
    33	    log = tmp_path / "queue-state.jsonl"
    34	    kwargs = {
    35	        "account_id": "user@example.com",
    36	        "thread_id": "thread-1",
    37	        "from_state": "inbound",
    38	        "to_state": "extracted",
    39	    }
    40	
    41	    queue_state.transition(log, ts_utc="2026-04-20T00:00:00Z", **kwargs)
