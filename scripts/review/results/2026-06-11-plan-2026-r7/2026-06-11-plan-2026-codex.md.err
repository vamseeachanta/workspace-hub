     1	import subprocess
     2	import sys
     3	from pathlib import Path
     4	
     5	
     6	ROOT = Path(__file__).resolve().parents[2]
     7	HOOK = ROOT / "scripts" / "email" / "fixture-redaction-check.py"
     8	
     9	
    10	def run_hook(path: Path):
    11	    return subprocess.run(
    12	        [sys.executable, str(HOOK), str(path)],
    13	        cwd=ROOT,
    14	        text=True,
    15	        stdout=subprocess.PIPE,
    16	        stderr=subprocess.PIPE,
    17	        check=False,
    18	    )
    19	
    20	
    21	def test_fixture_redaction_rejects_real_domains(tmp_path):
    22	    fixture = tmp_path / "bad.yaml"
    23	    fixture.write_text(
    24	        "sender: person@aceengineer.com\nphone: 713-555-0181\n",
    25	        encoding="utf-8",
    26	    )
    27	
    28	    result = run_hook(fixture)
    29	
    30	    assert result.returncode == 1
    31	    assert "real email/domain" in result.stderr
    32	
    33	
    34	def test_fixture_redaction_allows_placeholder_domains(tmp_path):
    35	    fixture = tmp_path / "good.yaml"
    36	    fixture.write_text(
    37	        "sender: client@example.com\nreply_to: broker@test.invalid\n",
    38	        encoding="utf-8",
    39	    )
    40	
    41	    result = run_hook(fixture)
    42	
    43	    assert result.returncode == 0, result.stderr

