     1	from pathlib import Path
     2	
     3	import yaml
     4	
     5	
     6	ROOT = Path(__file__).resolve().parents[2]
     7	
     8	
     9	def load_yaml(path: str):
    10	    with (ROOT / path).open(encoding="utf-8") as handle:
    11	        return yaml.safe_load(handle)
    12	
    13	
    14	def test_email_queue_state_schema_defines_required_sections():
    15	    schema = load_yaml("docs/design/email-queue-state-schema.yaml")
    16	
    17	    assert schema["version"] == 1
    18	    assert set(schema["schemas"]) >= {
    19	        "queue_state_entry",
    20	        "queue_learning_log_entry",
    21	        "queue_state_snapshot",
    22	        "queue_state_snapshot_meta",
    23	    }
    24	
    25	    state_required = set(schema["schemas"]["queue_state_entry"]["required"])
    26	    assert {
    27	        "account_id",
    28	        "thread_id",
    29	        "from_state",
    30	        "to_state",
    31	        "ts_utc",
    32	        "writer_identity",
    33	    } <= state_required
    34	
    35	    writer_required = set(
    36	        schema["schemas"]["queue_state_entry"]["properties"]["writer_identity"][
    37	            "required"
    38	        ]
    39	    )
    40	    assert {"process_name", "pid", "hostname", "boot_id"} <= writer_required
    41	
    42	
    43	def test_snapshot_schema_uses_account_thread_composite_key():
    44	    schema = load_yaml("docs/design/email-queue-state-schema.yaml")
    45	    snapshot = schema["schemas"]["queue_state_snapshot"]
    46	
    47	    assert snapshot["type"] == "object"
    48	    assert snapshot["additionalProperties"]["required"][:2] == [
    49	        "account_id",
    50	        "thread_id",
    51	    ]
    52	    assert snapshot["key_format"] == "{account_id}::{thread_id}"
    53	
    54	
    55	def test_spam_rules_yaml_contains_letstok_contract():
    56	    rules = load_yaml("scripts/email/spam-detection-rules.yaml")
    57	    rule_by_id = {rule["id"]: rule for rule in rules["rules"]}
    58	
    59	    letstok = rule_by_id["letstok_web_form_abuse"]
    60	    assert letstok["classification"] == "spam"
    61	    assert letstok["action_for_unmapped_sender"] == "DELETE"
    62	    assert letstok["state_tracking"] == "skip"
    63	    assert "fatigue analysis" in " ".join(letstok["contains_any"]).lower()
    64	    assert "offshore engineering" in " ".join(letstok["contains_any"]).lower()
    65	
    66	
    67	def test_cre_listing_schema_covers_required_fields_and_senders():
    68	    schema = load_yaml("scripts/email/extraction-schemas/cre-listing-v1.yaml")
    69	
    70	    assert schema["schema_id"] == "cre-listing-v1"
    71	    assert schema["target_path"] == "assethold/data/cre-listings"
    72	    assert {
    73	        "sandsig.com",
    74	        "marcusmillichap.com",
    75	        "partnersrealestate.com",
    76	        "email.loopnet.com",
    77	        "ten-x.ccsend.com",
    78	        "c.costarmail.com",
    79	    } <= set(schema["sender_domains"])
    80	
    81	    fields = {field["name"] for field in schema["fields"]}
    82	    assert {
    83	        "property_type",
    84	        "price",
    85	        "cap_rate",
    86	        "square_feet",
    87	        "location",
    88	        "sender",
    89	    } <= fields
    90	
    91	
    92	def test_routing_yaml_sandsig_and_skylineseven_route_to_cre_data():
    93	    routing = load_yaml("scripts/email/email-routing.yaml")
    94	
    95	    assert routing["rules"]["sandsig.com"] == "assethold/data/cre-listings"
    96	    assert routing["rules"]["skylineseven.ccsend.com"] == (
    97	        "assethold/data/cre-listings"
