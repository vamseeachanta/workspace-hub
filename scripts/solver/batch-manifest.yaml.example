# Batch submission manifest — submit multiple solver jobs at once
# Usage: bash scripts/solver/submit-batch.sh manifests/my-batch.yaml [--dry-run]
#
# Each job entry requires:
#   solver:     orcawave | orcaflex
#   input_file: path relative to repo root
#   description: (optional) human-readable label

jobs:
  - solver: orcawave
    input_file: docs/domains/orcawave/L00_validation_wamit/2.1/OrcaWave v11.0 files/test01.owd
    description: "L00 WAMIT validation smoke test"

  - solver: orcawave
    input_file: docs/domains/orcawave/L01_box_barge/2.1/OrcaWave v11.0 files/box_barge.owd
    description: "L01 box barge frequency sweep"

  - solver: orcaflex
    input_file: models/mooring/catenary_riser_A01.dat
    description: "A01 catenary riser mooring analysis"
