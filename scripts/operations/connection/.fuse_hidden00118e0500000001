#!/usr/bin/env bash
# ABOUTME: Open a VNC desktop session to ace-linux-2 via SSH tunnel
# ABOUTME: Forwards port 5901, ensures vncserver@:1 user-service is up, launches xtigervncviewer

set -euo pipefail

ACE2_USER="vamsee"
ACE2_ALIAS="ace-linux-2"
ACE2_TAILSCALE="10.1.0.2"
DISPLAY_NUM=":1"
LOCAL_PORT=5901
REMOTE_PORT=5901

echo "=== VNC → ace-linux-2 (display ${DISPLAY_NUM}, port ${REMOTE_PORT}) ==="

if ! command -v xtigervncviewer &>/dev/null; then
    echo "ERROR: xtigervncviewer not found. Install: sudo apt install tigervnc-viewer"
    exit 1
fi

# Resolve host: prefer alias, fall back to Tailscale IP
if ssh -o ConnectTimeout=3 -o BatchMode=yes "${ACE2_USER}@${ACE2_ALIAS}" exit 2>/dev/null; then
    TARGET="${ACE2_USER}@${ACE2_ALIAS}"
else
    echo "Alias unreachable, trying Tailscale (${ACE2_TAILSCALE})..."
    TARGET="${ACE2_USER}@${ACE2_TAILSCALE}"
fi

# Ensure vncserver@:1 is listening; start the user service if not
echo "Checking TigerVNC on ${TARGET}..."
if ! ssh "${TARGET}" "ss -tlnp 2>/dev/null | grep -q '127.0.0.1:${REMOTE_PORT}'"; then
    echo "vncserver@${DISPLAY_NUM} not listening — starting user service..."
    ssh "${TARGET}" "systemctl --user start vncserver@${DISPLAY_NUM}.service"

    # Poll up to 5s for the listener
    for i in $(seq 1 10); do
        sleep 0.5
        if ssh "${TARGET}" "ss -tlnp 2>/dev/null | grep -q '127.0.0.1:${REMOTE_PORT}'"; then
            break
        fi
        if [ "$i" -eq 10 ]; then
            echo "ERROR: vncserver still not listening on 127.0.0.1:${REMOTE_PORT} after 5s."
            echo "  Debug: ssh ${TARGET} 'systemctl --user status vncserver@${DISPLAY_NUM}.service'"
            echo "         ssh ${TARGET} 'tail -n 40 ~/.vnc/ace-linux-2${DISPLAY_NUM}.log'"
            exit 1
        fi
    done
    echo "vncserver@${DISPLAY_NUM} is up."
fi

echo "Starting SSH tunnel ${LOCAL_PORT} → ${TARGET}:${REMOTE_PORT}..."
ssh -L "${LOCAL_PORT}:127.0.0.1:${REMOTE_PORT}" "${TARGET}" -N &
TUNNEL_PID=$!
trap 'kill "${TUNNEL_PID}" 2>/dev/null || true' EXIT

# Wait for local tunnel to be ready
for i in $(seq 1 10); do
    sleep 0.5
    if ss -tlnp 2>/dev/null | grep -q ":${LOCAL_PORT}"; then
        break
    fi
    if [ "$i" -eq 10 ]; then
        echo "ERROR: SSH tunnel did not establish after 5s"
        exit 1
    fi
done

echo "Launching VNC viewer (localhost:${LOCAL_PORT}, SecurityTypes=None)..."
xtigervncviewer -SecurityTypes None "localhost:${LOCAL_PORT}"

echo "Tunnel closed."

# Usage:
#   ./vnc-ace-linux-2.sh
#
# Architecture (set up 2026-04-27, replaces broken x11vnc.service):
#   Remote: ~/.config/systemd/user/vncserver@.service (TigerVNC, lingering user)
#           Listens on 127.0.0.1:5901 only, SecurityTypes=None, GNOME via Xorg.
#   Local:  SSH tunnel 5901→5901, xtigervncviewer with -SecurityTypes None.
#
# Manual ops on ace-linux-2:
#   systemctl --user status  vncserver@:1.service
#   systemctl --user restart vncserver@:1.service
#   systemctl --user stop    vncserver@:1.service
#   tail -n 80 ~/.vnc/ace-linux-2:1.log
#
# Rollback (remove TigerVNC setup entirely):
#   ssh ace-linux-2 'systemctl --user disable --now vncserver@:1.service && \
#                    rm -rf ~/.vnc ~/.config/systemd/user/vncserver@.service'
