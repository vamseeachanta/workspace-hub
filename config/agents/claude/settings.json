{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 180,
  "env": {
    "MAX_TEAMMATES": "10",
    "REVIEW_GATE_STRICT": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(bash */scripts/operations/merge-when-clean.sh *)",
      "Bash(codex exec:*)"
    ],
    "deny": [
      "Bash(base64:*)",
      "Bash(bash -c:*)",
      "Bash(chmod 777:*)",
      "Bash(crontab:*)",
      "Bash(curl * | bash:*)",
      "Bash(curl * | sh:*)",
      "Bash(dd if=/dev/zero:*)",
      "Bash(doas:*)",
      "Bash(eval:*)",
      "Bash(git -c core.hooksPath:*)",
      "Bash(git -c core.hookspath:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(mkfs:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(node -e:*)",
      "Bash(perl -e:*)",
      "Bash(pkexec:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(rm -rf .:*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~:*)",
      "Bash(ruby -e:*)",
      "Bash(sh -c:*)",
      "Bash(shred:*)",
      "Bash(su :*)",
      "Bash(sudo:*)",
      "Bash(systemctl:*)",
      "Bash(wget * -O- | bash:*)",
      "Bash(wget * -O- | sh:*)",
      "Bash(xxd:*)",
      "Bash(zsh -c:*)",
      "Bash(| bash:*)",
      "Bash(| sh:*)"
    ]
  },
  "plansDirectory": ".planning",
  "showThinkingSummaries": true,
  "outputStyle": "Explanatory",
  "effortLevel": "high",
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      ".cache",
      ".venv",
      "__pycache__"
    ],
    "sparsePaths": []
  },
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Engineering",
      "Analyzing",
      "Modeling",
      "Simulating",
      "Calibrating"
    ]
  }
}
