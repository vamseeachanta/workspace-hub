# Hermes Agent — shared config template
# Managed by workspace-hub; synced via scripts/_core/sync-agent-configs.sh
# Machine-specific overrides (auth, paths) are preserved during merge.
#
# DO NOT put API keys or tokens here — those go in ~/.hermes/auth.json and ~/.hermes/.env
#
model:
  default: gpt-5.5
  provider: openai-codex
fallback_providers: []
credential_pool_strategies:
  openai-codex: round_robin
toolsets:
- hermes-cli
agent:
  max_turns: 90
  tool_use_enforcement: auto
terminal:
  backend: local
  cwd: .
  timeout: 180
  env_passthrough: []
  persistent_shell: true
browser:
  inactivity_timeout: 120
  command_timeout: 30
  record_sessions: false
  allow_private_urls: false
checkpoints:
  enabled: true
  max_snapshots: 50
file_read_max_chars: 100000
compression:
  enabled: true
# Skills: wire workspace-hub ecosystem skills into Hermes as read-only external dirs.
# Machine roots are resolved from config/workstations/registry.yaml by sync-agent-configs.sh.
# __WS_HUB_PATH__ is the canonical workspace-hub checkout.
# __TIER1_REPO_ROOT__ is the sibling root containing tier-1 checkouts.
# The sync resolver filters sibling roots to registry-listed repos that exist and contain SKILL.md.
skills:
  external_dirs:
    - __WS_HUB_PATH__/.claude/skills
    # Registry-derived sibling repo skill dirs are inserted by sync-agent-configs.sh.
    __REGISTRY_REPO_SKILL_DIRS__
