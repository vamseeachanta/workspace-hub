            - rejected
        output_residency:
          enum:
            - public_llm_wiki
            - domain_private_corpus
            - registered_client_private_corpus
            - ignored_internal_run_artifact
            - no_preserve
        promotion_decision: {type: string, minLength: 1}
        promotion_gates:
          type: array
          items:
            enum:
              - provenance
              - license
              - legal
              - sanitization
              - owner-review
        sanitization_gate:
          enum:
            - pass
