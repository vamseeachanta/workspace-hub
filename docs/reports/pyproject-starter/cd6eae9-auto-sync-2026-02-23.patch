-                    "errors": [str(e)]
-                })
-    
-    # Generate summary
-    logger.info("\n" + "=" * 50)
-    logger.info("📊 Summary")
-    logger.info("=" * 50)
-    
-    successful = sum(1 for r in results if r.get("success", False))
-    failed = len(results) - successful
