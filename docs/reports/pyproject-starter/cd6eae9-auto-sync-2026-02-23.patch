-workflow_refresh:
-  enabled: true  # DEFAULT: Always enabled
-  
-  detection:
-    implementation_changes: true
-    dependency_updates: true
-    documentation_changes: true
-    repository_changes: true
-    check_interval: 1w  # Weekly check interval
-    
-  update:
-    auto_apply: true
-    validation_required: true
