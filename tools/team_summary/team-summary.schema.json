{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-hub/tools/team_summary/team-summary.schema.json",
  "title": "Client team summary",
  "description": "Facts for the daily client team summary (workspace-hub#3967). Every item carries a source.",
  "type": "object",
  "required": [
    "client",
    "as_of",
    "learn_or_solve",
    "priorities",
    "issues"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Wiki-relative path or URL backing the item."
    },
    "reviewSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "link_base": {
          "type": "string",
          "minLength": 1,
          "description": "URL prefix under which wiki-relative paths resolve for the team."
        },
        "copies_dir": {
          "type": "string",
          "minLength": 1,
          "description": "Wiki-relative folder where HTML review copies and saved comments live."
        },
        "return_to": {
          "type": "string",
          "minLength": 1,
          "description": "Short text saying where saved comments files go back."
        }
      }
    },
    "itemReview": {
      "type": "object",
      "required": [
        "doc",
        "ask"
      ],
      "additionalProperties": false,
      "properties": {
        "doc": {
          "type": "string",
          "minLength": 1,
          "description": "Wiki-relative document path that needs input, approval, a conclusion, or comments."
        },
        "ask": {
          "enum": [
            "input",
            "approval",
            "conclusion",
            "comments"
          ]
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "area": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "review": {
            "$ref": "#/$defs/itemReview"
          }
        }
      }
    }
  },
  "properties": {
    "client": {
      "$ref": "#/$defs/text"
    },
    "as_of": {
      "type": "string",
      "format": "date"
    },
    "wiki_revision": {
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/reviewSettings"
    },
    "learn_or_solve": {
      "$ref": "#/$defs/text"
    },
    "priorities": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "title",
          "owner",
          "next_action",
          "due",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "#/$defs/text"
          },
          "owner": {
            "$ref": "#/$defs/text"
          },
          "next_action": {
            "$ref": "#/$defs/text"
          },
          "due": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "const": "TBD"
              }
            ],
            "description": "ISO date, or TBD when the wiki records no date."
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "review": {
            "$ref": "#/$defs/itemReview"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "status",
          "owner",
          "next_action",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "#/$defs/text"
          },
          "status": {
            "enum": [
              "open",
              "investigating",
              "awaiting-review",
              "resolved"
            ]
          },
          "owner": {
            "$ref": "#/$defs/text"
          },
          "next_action": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "review": {
            "$ref": "#/$defs/itemReview"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "text",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "owner",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "$ref": "#/$defs/text"
          },
          "owner": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "review": {
            "$ref": "#/$defs/itemReview"
          }
        }
      }
    },
    "areas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "marketing": {
          "$ref": "#/$defs/area"
        },
        "technical": {
          "$ref": "#/$defs/area"
        },
        "data": {
          "$ref": "#/$defs/area"
        },
        "projects": {
          "$ref": "#/$defs/area"
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "status",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "version": {
            "$ref": "#/$defs/text"
          },
          "status": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "$ref": "#/$defs/source"
          },
          "review": {
            "$ref": "#/$defs/itemReview"
          }
        }
      }
    }
  }
}
