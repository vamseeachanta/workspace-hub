{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/legal-rule-map-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_revision", "generation", "rules", "schema_id"],
  "properties": {
    "authority_revision": {"$ref": "#/$defs/uuid4"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_b64", "rule_id"],
        "properties": {
          "pattern_b64": {"type": "string", "minLength": 4, "maxLength": 21848, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},
          "rule_id": {"$ref": "#/$defs/uuid4"}
        }
      }
    },
    "schema_id": {"const": "legal-rule-map-v1"}
  },
  "$defs": {
    "uuid4": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
