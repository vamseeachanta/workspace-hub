{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/legal-rule-generation-ledger-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "key_id", "ledger_mac", "schema_id"],
  "properties": {
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_revision", "generation", "manifest_mac"],
        "properties": {
          "authority_revision": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
          "generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
          "manifest_mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "key_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\x21-\\x7e]+$"},
    "ledger_mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_id": {"const": "legal-rule-generation-ledger-v1"}
  }
}
