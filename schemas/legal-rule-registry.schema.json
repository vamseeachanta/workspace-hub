{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/legal-rule-registry-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["authority_revision", "generation", "rules", "schema_id"],
  "properties": {
    "authority_revision": {"$ref": "#/$defs/uuid4"},
    "generation": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match_mode", "rule_id", "severity", "target"],
        "properties": {
          "match_mode": {"enum": ["exact-bytes", "ascii-fold"]},
          "rule_id": {"$ref": "#/$defs/uuid4"},
          "severity": {"enum": ["block", "warn"]},
          "target": {"enum": ["path", "content", "both"]}
        }
      }
    },
    "schema_id": {"const": "legal-rule-registry-v1"}
  },
  "$defs": {
    "uuid4": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}
